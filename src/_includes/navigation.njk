<nav class="navbar navbar-expand-lg navbar-light fixed-top px-4 px-lg-5 wow fadeIn{% if pageKey != 'home' %} navbar-scrolled{% endif %}" data-wow-delay="0.1s">
    <a href="index.html#home" class="navbar-brand fw-bold">Mehdi TAZI</a>
    <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="{{ common.toggleNavigation }}"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse justify-content-end py-4 py-lg-0" id="navbarCollapse">
        <div class="navbar-nav align-items-lg-center py-0">
            <a href="index.html#home" class="nav-item nav-link">{{ common.navigation.contact }}</a>
            <a href="index.html#about" class="nav-item nav-link">{{ common.navigation.about }}</a>
            <a href="index.html#professional" class="nav-item nav-link">{{ common.navigation.expertise }}</a>
            <a href="index.html#testimonial" class="nav-item nav-link">{{ common.navigation.testimonials }}</a>
            <a href="ventures.html" class="nav-item nav-link{% if pageKey == 'ventures' %} active{% endif %}"{% if pageKey == 'ventures' %} aria-current="page"{% endif %}>{{ common.navigation.ventures }}</a>
            <a href="perspectives.html" class="nav-item nav-link{% if pageKey == 'perspectives' %} active{% endif %}"{% if pageKey == 'perspectives' %} aria-current="page"{% endif %}>{{ common.navigation.perspectives }}</a>
        </div>
        <div class="site-language-switcher ms-lg-3 mt-3 mt-lg-0" role="group" aria-label="{{ common.siteLanguage }}">
            <i class="bi bi-globe" aria-hidden="true"></i>
            <a href="{% if locale.code == 'fr' %}../{% endif %}{{ pageFile }}" class="site-language-link{% if locale.code == 'en' %} is-current{% endif %}" lang="en" hreflang="en" aria-label="{{ common.switchEnglish }}"{% if locale.code == 'en' %} aria-current="true"{% endif %} data-site-language="en">EN</a>
            <span class="site-language-divider" aria-hidden="true"></span>
            <a href="{% if locale.code == 'en' %}fr/{% endif %}{{ pageFile }}" class="site-language-link{% if locale.code == 'fr' %} is-current{% endif %}" lang="fr" hreflang="fr" aria-label="{{ common.switchFrench }}"{% if locale.code == 'fr' %} aria-current="true"{% endif %} data-site-language="fr">FR</a>
        </div>
    </div>
</nav>
