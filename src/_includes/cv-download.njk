<div class="resume-download-group dropdown" role="group" aria-label="{{ common.downloadCV }}">
    <a href="{{ cv[locale.code] }}" class="resume-download-link" target="_blank" rel="noopener noreferrer" aria-label="{{ common.downloadDefault }}"><i class="bi bi-file-earmark-arrow-down" aria-hidden="true"></i><span>{{ common.downloadCV }}</span></a>
    <button class="resume-language-toggle" type="button" id="{{ downloadId }}-cv-language" data-bs-toggle="dropdown" aria-expanded="false" aria-controls="{{ downloadId }}-cv-languages" aria-label="{{ common.chooseCV }}">{{ locale.code | upper }}</button>
    <ul class="dropdown-menu dropdown-menu-end resume-language-menu" id="{{ downloadId }}-cv-languages" aria-labelledby="{{ downloadId }}-cv-language">
        <li><a class="dropdown-item" href="{{ cv.en }}" target="_blank" rel="noopener noreferrer" lang="en"><span>English</span><span class="resume-file-type">PDF</span></a></li>
        <li><a class="dropdown-item" href="{{ cv.fr }}" target="_blank" rel="noopener noreferrer" lang="fr"><span>Français</span><span class="resume-file-type">PDF</span></a></li>
    </ul>
</div>
