<!DOCTYPE html>
<!-- Generated by Eleventy. Edit src/ templates and content, then run npm run build. -->
<html lang="{{ locale.code }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ copy[locale.code][pageKey].metaTitle }}</title>
    <meta name="description" content="{{ copy[locale.code][pageKey].metaDescription }}">
    <meta name="author" content="Mehdi TAZI">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' https://embedr.flickr.com https://www.flickr.com https://*.staticflickr.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net data:; img-src 'self' data: https://live.staticflickr.com https://*.staticflickr.com https://*.flickr.com; connect-src 'self' https://www.flickr.com https://*.staticflickr.com; frame-src 'none'; form-action 'self'; upgrade-insecure-requests">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <link rel="canonical" href="{{ pageKey | pageUrl(locale.code) }}">
    <link rel="alternate" hreflang="en" href="{{ pageKey | pageUrl('en') }}">
    <link rel="alternate" hreflang="fr" href="{{ pageKey | pageUrl('fr') }}">
    <link rel="alternate" hreflang="x-default" href="{{ pageKey | pageUrl('en') }}">
    <link href="{{ assetRoot }}img/favicon.ico" rel="icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet" integrity="sha384-0c38nfCMzF8w8DBI+9nTWzApOpr1z0WuyswL4y6x/2ZTtmj/Ki5TedKeUcFusC/k" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet" integrity="sha384-NUDU7Qr8dfscXBIhA0px/bRl3cgNrOT9l/WPm15DzH5xnBs4fL4vgRiXURs98/ID" crossorigin="anonymous">
    <link href="{{ assetRoot }}lib/animate/animate.min.css" rel="stylesheet">
    {% if pageKey == 'home' %}
    <link href="{{ assetRoot }}lib/lightbox/css/lightbox.min.css" rel="stylesheet">
    <link href="{{ assetRoot }}lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    {% endif %}
    {% if pageKey == 'perspectives' %}<link href="{{ assetRoot }}lib/jsvectormap/dist/css/jsvectormap.min.css" rel="stylesheet">{% endif %}
    <link href="{{ assetRoot }}css/bootstrap.min.css" rel="stylesheet">
    <link href="{{ assetRoot }}css/style.css?v={{ site.version }}" rel="stylesheet">
</head>
<body{% if pageKey == 'home' %} data-bs-spy="scroll" data-bs-target=".navbar" data-bs-offset="51"{% elif pageKey == 'perspectives' %} class="travel-redesign"{% endif %} data-site-root="{{ assetRoot }}">
    <noscript><style>#spinner{display:none!important}.navbar{position:relative!important}.navbar-collapse{display:block!important}.navbar-toggler{display:none}.owl-carousel{display:block!important}</style></noscript>
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"><span class="visually-hidden">{{ common.loading }}</span></div>
    </div>
    {% include 'navigation.njk' %}
    {{ content | safe }}
    {% include 'footer.njk' %}
    <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top" aria-label="{{ common.backToTop }}"><i class="bi bi-arrow-up" aria-hidden="true"></i></a>
    <script src="{{ assetRoot }}lib/jquery/jquery-3.7.1.min.js"></script>
    <script src="{{ assetRoot }}lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="{{ assetRoot }}lib/wow/wow.min.js"></script>
    <script src="{{ assetRoot }}lib/easing/easing.min.js"></script>
    {% if pageKey == 'home' %}
    <script src="{{ assetRoot }}lib/waypoints/waypoints.min.js"></script>
    <script src="{{ assetRoot }}lib/typed/typed.min.js"></script>
    <script src="{{ assetRoot }}lib/counterup/counterup.min.js"></script>
    <script src="{{ assetRoot }}lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="{{ assetRoot }}lib/isotope/isotope.pkgd.min.js"></script>
    <script src="{{ assetRoot }}lib/lightbox/js/lightbox.min.js"></script>
    {% endif %}
    <script src="{{ assetRoot }}js/language-switcher.js?v={{ site.version }}"></script>
    <script src="{{ assetRoot }}js/main.js?v={{ site.version }}"></script>
    {% if pageKey == 'perspectives' %}
    <script src="{{ assetRoot }}lib/jsvectormap/dist/js/jsvectormap.min.js"></script>
    <script src="{{ assetRoot }}lib/jsvectormap/dist/maps/world.js"></script>
    <script src="{{ assetRoot }}data/travel-albums.js?v={{ site.version }}"></script>
    <script src="{{ assetRoot }}js/locales/{{ locale.code }}/perspectives.js?v={{ site.version }}"></script>
    <script src="{{ assetRoot }}js/perspectives.js?v={{ site.version }}"></script>
    {% endif %}
</body>
</html>
